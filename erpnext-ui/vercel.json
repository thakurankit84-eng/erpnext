{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://YOUR-ERPNEXT-SITE.example.com/api/:path*" },
    { "source": "/files/:path*", "destination": "https://YOUR-ERPNEXT-SITE.example.com/files/:path*" },
    { "source": "/private/files/:path*", "destination": "https://YOUR-ERPNEXT-SITE.example.com/private/files/:path*" },
    { "source": "/((?!api/|files/|private/).*)", "destination": "/index.html" }
  ]
}
